# =============================================================================
# .env.example — MCP HUB SERVER IA
# -----------------------------------------------------------------------------
# Copia este archivo a `.env` y completa tus valores. NUNCA subas `.env` real.
# `config.py` lee estas variables al arrancar (ver Settings / get_settings()).
#
#   cp .env.example .env        # Linux/macOS
#   copy .env.example .env     # Windows (cmd)
# =============================================================================

# ---------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------
# Puerto HTTP donde escucha uvicorn (default 10000).
PORT=10000

# Nivel de logging de la aplicación (CRITICAL|ERROR|WARNING|INFO|DEBUG).
# Default: INFO
LOG_LEVEL=INFO

# Modo local transitorio: token compartido para FastAPI y MCP remoto.
# No usar HUB_API_TOKEN para un piloto público.
HUB_API_TOKEN=

# Habilitar para exigir tokens opacos individuales almacenados como hashes
# en PostgreSQL. Obligatorio en APP_ENV=production. En staging, habilítalo
# después de aplicar las migraciones y emitir al menos un cliente autorizado.
API_CLIENT_AUTH_ENABLED=false

# Basic Auth para /docs, /redoc y /openapi.json.
# Mantén estas credenciales separadas de las credenciales de integraciones.
HUB_DOCS_USERNAME=
HUB_DOCS_PASSWORD=

# Lista de servicios activos (separados por coma). Opcional; default lo asume todo.
# ACTIVE_SERVICES=echo_service,llm_chat_service,essay_evaluator_mcp

# ---------------------------------------------------------------
# PERSISTENCIA / BASE DE DATOS (ContextStore durable)
# ---------------------------------------------------------------
# DB_DSN es la variable canónica. DATABASE_URL se acepta como alias solo
# cuando DB_DSN no está definida; si DB_DSN está definida (incluso vacía),
# prevalece sobre DATABASE_URL.
# DSN SQLAlchemy async para contextos, cola de evaluaciones y submission tracker.
# SQLite y PostgreSQL comparten interfaz:
#   SQLite:      sqlite+aiosqlite:///./storage/hub.db
#   PostgreSQL:  postgresql+asyncpg://usuario:pass@host:5432/nombre_db
# Vacío o "memory" → backend en memoria transitorio (solo desarrollo; no durable).
# PostgreSQL de pruebas:
#   postgresql+asyncpg://hub_test_user:URL_ENCODED_PASSWORD@localhost:5432/hub_test
# Para usarlo, reemplaza el valor activo de DB_DSN por tu DSN local.
DB_DSN=sqlite+aiosqlite:///./storage/hub.db
# Alias heredado opcional:
# DATABASE_URL=
# Ruta del archivo SQLite (se usa cuando DB_DSN es SQLite con ruta relativa).
DB_SQLITE_PATH=storage/hub.db

# Máximo de envíos evaluables por tarea-estudiante (control de crónica LTI).
# Este es el límite GLOBAL. Puede sobrescribirse por tarea/petición enviando
# el campo "max_intentos" en el payload JSON del LTI (si viene, lo usa; si no, este).
# Default: 2
MAX_SUBMISSION_ATTEMPTS=2

# Contextos de actividades LMS permanecen activos hasta el cierre explícito.
# Después del cierre se conservan este número de días para procesar/reintentar
# trabajos y permitir recuperar resultados. Sobrescribible por actividad con
# context_grace_days en /context/init, el payload de evaluación o /context/{id}/close.
# Rango permitido: 0..365. Default: 3 días.
LMS_CONTEXT_GRACE_DAYS=3

# ---------------------------------------------------------------
# COMPILADOR DE PROMPTS / AHORRO DE TOKENS (FASE 1 · B1.3)
# ---------------------------------------------------------------
# La institución puede ajustar estos presupuestos según su naturaleza y la
# ventana de contexto del LLM que utilice (OpenRouter, Ollama, DeepSeek, etc.).

# Presupuesto (tokens) de la directiva institucional en la EVALUACIÓN de ensayos.
# Cuanto menor, más compacto el contexto; cuanto mayor, más detalle rico.
# Default: 512
PROMPT_EVAL_CONTEXT_BUDGET=512

# Presupuesto (tokens) de la directiva institucional en el CHAT LLM general.
# Default: 1024
PROMPT_CHAT_CONTEXT_BUDGET=1024

# Hint de idioma para la heurística de estimación de tokens (es|en|pt|...).
# Vacío / '' -> auto-detección por el contenido.
# Default: (vacío)
# PROMPT_CONTEXT_LANGUAGE=es

# Modo ASÍNCRONO de evaluación de ensayos:
# - Encolar:    POST /ensayos/enqueue   (202 inmediato con evaluation_id, estado PENDING)
# - Consultar:  GET  /ensayos/estado/{evaluation_id}
# La cola y su estado se persisten en la MISMA base que DB_DSN (tabla evaluation_jobs),
# y un worker procesa UNA evaluación a la vez (controla el rate-limit del LLM).
# No requiere variable extra: usa DB_DSN. Dejar DB_DSN vacío → cola en memoria (dev).

# ---------------------------------------------------------------
# OPENROUTER (motor LLM principal con fallback automático)
# ---------------------------------------------------------------
# Clave API de OpenRouter. REQUERIDA para el motor LLM (provider "modelo"/free).
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Endpoint de chat compatible con OpenAI (default OpenRouter).
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Endpoint del catálogo de modelos gratuitos.
OPENROUTER_MODELS_ENDPOINT=https://openrouter.ai/api/v1/models

# Modelo gratuito preferido (opcional). Si el preferido falla, se conmuta.
PREFERRED_FREE_MODEL=

# Tuning del motor de conmutación ultrarrápida (Hedged Racing + Circuit Breaker).
LLM_SOFT_TIMEOUT=3.5         # seg. tras el cual dispara el siguiente modelo en paralelo
LLM_HARD_TIMEOUT=12.0        # seg. máximo por intento individual
LLM_MAX_CONCURRENT=2         # modelos en carrera simultánea
OPENROUTER_MODELS_CACHE_TTL=1800  # TTL caché del catálogo (1/2h)

# ---------------------------------------------------------------
# PROVEEDOR LLM DeepSeek (vía OpenRouter)
# ---------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# ---------------------------------------------------------------
# PROVEEDOR LLM Google Gemma/Gemini (vía OpenRouter)
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_ENDPOINT=
# Modelo Gemma por defecto.
GEMMA_MODEL=google/gemma-4-31b-it:free

# ---------------------------------------------------------------
# PROVEEDOR LLM OpenAI
# ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Perfil de ejecución: production activa validaciones estrictas de seguridad.
APP_ENV=development
# Hosts permitidos para descargar adjuntos, separados por coma; obligatorio en producción.
ATTACHMENT_ALLOWED_HOSTS=

# ---------------------------------------------------------------
# OLLAMA (inferencia local / on-premise, privacidad de datos)
# ---------------------------------------------------------------
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.3:latest
OLLAMA_TIMEOUT=60.0

# ---------------------------------------------------------------
# ZOOM (reportes, gestión de sesiones y auditoría de licencias)
# ---------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BASE_URL=https://api.zoom.us/v2
# Ruta opcional del banner para encabezados de reportes Excel.
ZOOM_HEADER_IMAGE=

# ---------------------------------------------------------------
# CANVAS LMS (evaluación de ensayos / webhooks)
# ---------------------------------------------------------------
CANVAS_API_URL=
CANVAS_API_TOKEN=

# ---------------------------------------------------------------
# ACTIVE MQ ARTEMIS (broker STOMP, integración asíncrona LMS)
# ---------------------------------------------------------------
ARTEMIS_ENABLED=false
ARTEMIS_HOST=localhost
ARTEMIS_PORT=61613
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis
ARTEMIS_IN_QUEUE=/queue/lms.evaluaciones.in
ARTEMIS_OUT_QUEUE=/queue/lms.calificaciones.out

# ---------------------------------------------------------------
# OTROS
# ---------------------------------------------------------------
# URL de webhook LMS para notificación de resultados (opcional).
LMS_WEBHOOK_URL=